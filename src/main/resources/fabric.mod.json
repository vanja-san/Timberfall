{
	"schemaVersion": 1,
	"id": "timberfall",
	"version": "${version}",
	"name": "Timberfall",
	"description": "Efficiently fell entire trees with a single chop. Fully configurable, tick-safe, and stable",
	"authors": [
		"vanja-san"
	],
	"contact": {
		"homepage": "https://github.com/vanja-san/Timberfall",
		"sources": "https://github.com/vanja-san/Timberfall"
	},
	"license": "CC0-1.0",
	"icon": "assets/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"mod.timberfall.Mod"
		],
		"client": [
			"mod.timberfall.client.Client"
		]
	},
	"mixins": [
		"timberfall.mixins.json",
		{
			"config": "timberfall.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}